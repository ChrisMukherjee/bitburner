// Second opinion on "reset now or keep going?", next to the repo's rule. Run it by hand: run reset-compare.js
//
// Both rules maximise the same thing: augmentation value gained per hour of play, because augmentations carry into every
// later run (that is the point of resetting). The difference is the cost of a reset:
//   Repo rule:  value / (run age + 5 min fixed overhead).
//   This one:   value / (run age + 5 min + the REBUILD cost measured from your own income log).
// Rebuild cost = hours of full-speed income this run lost while it built up to today's income level,
//   L = integral over the run of (1 - I(t) / I_now) dt, from income-log.txt (hacking income only);
// the next run rebuilds m times faster (m = e^value of the augmentations installed), so it costs L / m.
// The forecast of value over time comes from the repo's plan (data/aug-plan.json), so the same augmentations are counted.
/** @param {NS} ns */
export async function main(ns) {
    // --quiet: used by the orchestrator; prints nothing, only writes reset-verdict.txt (used by automatic resets)
    const quiet = ns.args.includes("--quiet");
    const say = (m) => { if (!quiet) ns.tprint(m); };
    const verdict = (reset) => { if (reset === null) ns.rm("reset-verdict.txt", "home"); else ns.write("reset-verdict.txt", JSON.stringify({ t: Date.now(), reset }), "w"); };
    verdict(null);
    let plan = null, rows = [];
    try { plan = JSON.parse(ns.read("data/aug-plan.json")); } catch { }
    try { rows = JSON.parse(ns.read("income-log.txt") || "[]"); } catch { }
    const installedAt = Number(ns.read("reset-info.txt")) || 0;
    if (!plan?.decision?.curve) { say("No plan yet (data/aug-plan.json). The orchestrator writes one every 20 minutes."); return; }
    const d = plan.decision;
    say(`Repo rule (plan ${Math.round((Date.now() - plan.checkedAt) / 60000)} min old): ${d.reset ? "RESET" : "WAIT"} - ${d.reason}`);

    // While Bladeburner is the route the plan's value counts combat/Bladeburner augments (utils/config.js routeAdjust) and the cost of a reset is
    // retraining the combat stats, which takes minutes once the multiplier is up. The hacking-income rebuild cost below does not apply: follow the plan.
    if (["train", "run"].includes(String(ns.read("bb-state.txt")))) {
        say("Bladeburner route: the plan values combat/Bladeburner augments, and a reset only costs retraining the combat stats (minutes with the new multiplier), so the hacking-income comparison is skipped and the plan's verdict stands.");
        verdict(!!d.reset);
        return;
    }

    const pts = rows.filter(r => r.t >= installedAt).map(r => ({ x: (r.t - installedAt) / 3600000, y: r.inc }));
    if (pts.length < 4 || pts[pts.length - 1].x - pts[0].x < 1 / 3) {
        const span = pts.length > 1 ? Math.round((pts[pts.length - 1].x - pts[0].x) * 60) : 0;
        say(`My rule: not enough income history yet. Have ${pts.length} samples covering ${span} min; needs at least 4 samples covering 20 min (one sample every 5 min). Try again in a few minutes.`);
        return;
    }
    const T = pts[pts.length - 1].x;
    const now = d.curve[0];
    const m = Math.exp(Math.max(0, now.value));
    // Income level to measure the build-up against: the average of the last few samples
    const last = pts.slice(-4);
    const iNow = last.reduce((s, p) => s + p.y, 0) / last.length;
    if (iNow <= 0) { say("My rule: no hacking income logged yet (is the batcher posting on port 24? restart it once)."); return; }
    // L: trapezoids over the log, from run start (income 0) to now
    let lost = 0, px = 0, py = 0;
    for (const p of pts) { lost += (p.x - px) * (1 - (Math.min(py, iNow) + Math.min(p.y, iNow)) / 2 / iNow); px = p.x; py = p.y; }
    const rebuildH = lost / Math.max(m, 1.0001);
    const overheadH = 5 / 60 + rebuildH;

    const rate = (point) => point.value / (T + point.inMinutes / 60 + overheadH);
    const nowRate = rate(now);
    const maxWaitMin = Number(plan.maxWaitMinutes ?? 60);
    const later = d.curve.slice(1).filter(p => p.inMinutes <= maxWaitMin).reduce((best, p) => (!best || rate(p) > rate(best) ? p : best), null);
    say(`My rule: this run built up its income over ${lost.toFixed(1)} h of lost output; the next run (x${m.toFixed(2)} faster) would lose about ${rebuildH.toFixed(2)} h of it.`);
    say(`  Reset now: x${m.toFixed(2)} gained after a ${T.toFixed(1)} h run + ${overheadH.toFixed(2)} h reset cost = ${nowRate.toFixed(3)} per hour.`);
    if (later) say(`  Best later moment: in ${later.inMinutes} min, x${Math.exp(later.value).toFixed(2)} = ${rate(later).toFixed(3)} per hour.`);
    // Same guarantee as the plan: an old run with a worthwhile batch resets
    const guaranteed = T >= 4 && now.value >= Math.log(1.5);
    const wait = !guaranteed && later && rate(later) > nowRate * 1.05;
    verdict(!wait);
    say(`  -> ${wait ? `WAIT (about ${later.inMinutes} min)` : "RESET"}${wait === !!d.reset ? "  (differs from the repo rule)" : "  (agrees with the repo rule)"}`);
    say("Estimate: hacking income only, and the speed-up is one flat factor. Its value comes from the repo's plan weights.");
}
