// Singularity: ONE pass of home RAM upgrades (buys while an upgrade costs at most MAX_FRACTION of cash), then exits.
// Writes home-ram-next.txt = cash needed for the next upgrade; the orchestrator only starts a pass when you have it.
// Writes home-ram-maxed.txt (reset stamp) when home is maxed. Ported from ChrisMukherjee/bitburner singularity/upgrade-home-ram.js.
const MAX_FRACTION = 0.5;

/** @param {NS} ns */
async function pass(ns) {
    ns.disableLog("ALL");
    if (!String(ns.read("sing-info.txt")).startsWith("1")) return;

    while (true) {
        const cost = ns.singularity.getUpgradeHomeRamCost();
        if (!Number.isFinite(cost)) {
            ns.write("home-ram-maxed.txt", String(ns.read("reset-info.txt")), "w");
            return;
        }
        if (cost > ns.getServerMoneyAvailable("home") * MAX_FRACTION) {
            ns.write("home-ram-next.txt", String(Math.ceil(cost / MAX_FRACTION)), "w");
            return;
        }
        const before = ns.getServerMaxRam("home");
        if (!ns.singularity.upgradeHomeRam()) {
            ns.write("home-ram-next.txt", String(Math.ceil(cost / MAX_FRACTION)), "w");
            return;
        }
        ns.toast(`Home RAM ${ns.format.ram(before)} -> ${ns.format.ram(ns.getServerMaxRam("home"))}`, "success", 15000);
    }
}

/** Entry point. When this runs on another server (see offHome in the orchestrator), results go back to home. */
export async function main(ns) {
    try { await pass(ns); }
    finally {
        if (ns.getHostname() !== "home") ns.scp(["home-ram-next.txt", "home-ram-maxed.txt"].filter(f => ns.fileExists(f)), "home");
    }
}
