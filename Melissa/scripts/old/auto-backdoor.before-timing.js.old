// Singularity: installs backdoors on the servers that matter, once rooted and your hacking level allows.
// Ported from ChrisMukherjee/bitburner singularity/auto-backdoor.js. Needs BitNode 4 or Source-File 4.
// It walks your terminal along the path and goes back home, so the terminal jumps around while it works.
// It roots nothing itself (the batcher does). Never backdoors w0r1d_d43m0n, which would end the BitNode.
// Does ONE pass then exits (holds no RAM while waiting). Writes backdoor-next.txt = time to try again, and
// backdoor-done.txt (reset stamp) when all are done.
const FIRST = [
    "CSEC", "avmnite-02h", "I.I.I.I", "run4theh111z", "fulcrumassets",               // hacker factions
    "ecorp", "megacorp", "b-and-a", "blade", "nwo", "clarkinc", "omnitek", "4sigma", "kuai-gong", "fulcrumtech", // megacorps
    "rothman-uni", "summit-uni", "zb-institute", "powerhouse-fitness", "iron-gym", "crush-fitness", "snap-fitness", "millenium-fitness", // gyms/unis
];
const COMPANIES = [
    "helios", "vitalife", "icarus", "univ-energy", "galactic-cyber", "aerocorp", "omnia", "solaris",
    "deltaone", "global-pharm", "nova-med", "lexo-corp", "rho-construction", "alpha-ent", "aevum-police",
    "syscore", "computek", "netlink", "stormtech", "defcomm", "omega-net", "n00dles", "foodnstuff", "joesguns",
];

/** @param {NS} ns */
async function pass(ns) {
    ns.disableLog("ALL");
    if (!String(ns.read("sing-info.txt")).startsWith("1")) { ns.print("Singularity is not available in this run."); return; }
    const order = [...FIRST, ...COMPANIES];

    {
        const routes = findRoutes(ns);
        let remaining = 0, doable = 0;
        for (const host of order) {
            if (!routes.has(host)) continue;
            const server = ns.getServer(host);
            if (server.backdoorInstalled) continue;
            remaining++;
            if (!server.hasAdminRights || ns.getHackingLevel() < server.requiredHackingSkill) continue;
            doable++;
            if (await backdoorHost(ns, routes.get(host))) { remaining--; ns.toast(`Backdoor installed on ${host}`, "success", 15000); }
        }
        if (remaining === 0) ns.write("backdoor-done.txt", String(ns.read("reset-info.txt")), "w");
        else ns.write("backdoor-next.txt", String(Date.now() + (doable > 0 ? 3 : 10) * 60 * 1000), "w");
    }
}

/** Walks the terminal along the route, backdoors the last server, then goes home. */
async function backdoorHost(ns, route) {
    try {
        ns.singularity.connect("home");
        for (const hop of route.slice(1)) if (!ns.singularity.connect(hop)) return false;
        await ns.singularity.installBackdoor();
        return ns.getServer(route[route.length - 1]).backdoorInstalled;
    } finally {
        ns.singularity.connect("home");
    }
}

/** Breadth-first from home: hostname -> ["home", ..., hostname]. */
function findRoutes(ns) {
    const routes = new Map([["home", ["home"]]]);
    const queue = ["home"];
    while (queue.length > 0) {
        const current = queue.shift();
        for (const next of ns.scan(current)) {
            if (routes.has(next)) continue;
            routes.set(next, [...routes.get(current), next]);
            queue.push(next);
        }
    }
    return routes;
}

/** Entry point. When this runs on another server (see offHome in the orchestrator), results go back to home. */
export async function main(ns) {
    try { await pass(ns); }
    finally {
        if (ns.getHostname() !== "home") ns.scp(["backdoor-next.txt", "backdoor-done.txt"].filter(f => ns.fileExists(f)), "home");
    }
}
