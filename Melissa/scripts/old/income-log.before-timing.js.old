// One-shot, started by the orchestrator every 5 minutes: appends (time, hacking income $/s, cash) to income-log.txt.
// reset-compare.js reads it to see how fast this run built up its income. The log restarts after every augmentation install.
// Only hacking income is logged (batcher figure on port 24, or running-script income); hacknet production is not included.
/** @param {NS} ns */
async function pass(ns) {
    const installedAt = Number(ns.read("reset-info.txt")) || 0;
    let rows = [];
    try { rows = JSON.parse(ns.read("income-log.txt") || "[]"); } catch { rows = []; }
    if (rows.length && rows[0].t < installedAt) rows = [];   // a new run: start over
    const posted = ns.peek(24);
    const fromBatcher = posted && typeof posted === "object" && Number.isFinite(posted.perSecond) && Date.now() - posted.time <= 5 * 60_000 ? posted.perSecond : 0;
    rows.push({ t: Date.now(), inc: Math.max(fromBatcher, ns.getTotalScriptIncome()[0]), cash: ns.getServerMoneyAvailable("home") });
    if (rows.length > 400) rows = rows.filter((_, i) => i % 2 === 0);   // thin out very long runs
    ns.write("income-log.txt", JSON.stringify(rows), "w");
}

export async function main(ns) {
    try { await pass(ns); }
    finally {
        if (ns.getHostname() !== "home") ns.scp("income-log.txt", "home");
    }
}
