/** @param {NS} ns */
export async function main(ns) {
  // Kill duplicate running instances of this script to avoid conflicts
  const myScript = ns.getRunningScript();
  const otherScripts = ns.ps(myScript.hostname).filter(s => s.filename === myScript.filename && s.pid !== myScript.pid);
  for (const s of otherScripts) {
    ns.kill(s.pid);
  }

  ns.print("Starting IPvGO multi-faction rotation bot...");

  const targets = [
    { name: "Netburners", size: 7 },
    { name: "Slum Snakes", size: 7 },
    { name: "The Black Hand", size: 9 },
    { name: "Tetrads", size: 9 },
    { name: "Daedalus", size: 9 },
    { name: "Illuminati", size: 9 }
  ];

  while (true) {
    // Loop through each faction sequentially
    for (const target of targets) {
      let isUnlocked = false;

      // 1. Try resetting the board for this faction
      try {
        ns.go.resetBoardState(target.name, target.size);
        isUnlocked = true; // If no error was thrown, faction is available!
      } catch (err) {
        ns.print(`Skipping ${target.name}: Not unlocked or discovered yet.`);
      }

      // 2. If locked, jump to the NEXT target in the array instead of restarting from Netburners
      if (!isUnlocked) continue;

      ns.print(`Switching focus to subnet: ${target.name} (Board Size: ${target.size})`);

      let gamesPlayed = 0;

      // Play 5 games against this faction before rotating to the next unlocked one
      while (gamesPlayed < 5) {
        let result;

        do {
          const board = ns.go.getBoardState();
          const validMoves = ns.go.analysis.getValidMoves();
          const liberties = ns.go.analysis.getLiberties();

          const [x, y] = selectBestMove(board, validMoves, liberties);

          if (x === undefined || y === undefined) {
            result = await ns.go.passTurn();
          } else {
            result = await ns.go.makeMove(x, y);
          }

          await ns.go.opponentNextTurn();
          await ns.sleep(100);

        } while (result?.type !== "gameOver");

        gamesPlayed++;
        ns.print(`Finished game ${gamesPlayed}/5 against ${target.name}.`);
        
        if (gamesPlayed < 5) {
          try {
            ns.go.resetBoardState(target.name, target.size);
          } catch (e) {
            break;
          }
        }
        await ns.sleep(500);
      }
    }
  }
}

/**
 * Evaluates the board using strict airspace rules and tactical priorities.
 */
const selectBestMove = (board, validMoves, liberties) => {
  const size = board.length;

  let emergencyDefense = null;
  let immediateAttack = null;
  
  let bestExpansion = null;
  let highestExpansionScore = 0;

  for (let x = 0; x < size; x++) {
    for (let y = 0; y < size; y++) {
      if (!validMoves[x]?.[y]) continue;

      const neighbors = [
        { nx: x + 1, ny: y },
        { nx: x - 1, ny: y },
        { nx: x, ny: y + 1 },
        { nx: x, ny: y - 1 }
      ];

      const emptyAdjacent = neighbors.filter(n => board[n.nx]?.[n.ny] === ".");
      const friendlyNeighbors = neighbors.filter(n => board[n.nx]?.[n.ny] === "X");
      
      let hasStrongFriendlyNeighbor = friendlyNeighbors.some(n => (liberties[n.nx]?.[n.ny] ?? 0) >= 3);
      const isSafeMove = (emptyAdjacent.length >= 2) || hasStrongFriendlyNeighbor;

      // 1. Tactical triggers (Atari defense/attack)
      for (const { nx, ny } of neighbors) {
        const piece = board[nx]?.[ny];
        const lib = liberties[nx]?.[ny] ?? 0;

        if (!piece) continue;

        if (piece === "X" && lib === 1 && isSafeMove) {
          emergencyDefense = [x, y];
        }

        if (piece === "O" && lib === 1) {
          immediateAttack = [x, y];
        }
      }

      // 2. Strict Airspace Expansion Check
      const isNotReservedSpace = (x % 2 === 1 || y % 2 === 1);

      if (isSafeMove && isNotReservedSpace) {
        let score = 0;
        score += friendlyNeighbors.length * 4;
        score += emptyAdjacent.length * 2;

        if (score > highestExpansionScore) {
          highestExpansionScore = score;
          bestExpansion = [x, y];
        }
      }
    }
  }

  if (emergencyDefense) return emergencyDefense;
  if (immediateAttack) return immediateAttack;
  if (bestExpansion) return bestExpansion;

  return [undefined, undefined];
};