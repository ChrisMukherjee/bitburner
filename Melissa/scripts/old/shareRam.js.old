/** @param {NS} ns */
export async function main(ns) {
    const workerScript = "share-worker.js";
    const reservedRam = 100// Leave X GB free so home always has breathing room
    
    ns.disableLog("getServerMaxRam");
    ns.disableLog("getServerUsedRam");
    ns.disableLog("sleep");

    // Ensure worker script exists on home automatically
    if (!ns.fileExists(workerScript, "home")) {
        await ns.write(
            workerScript, 
            '/** @param {NS} ns */\nexport async function main(ns) { while(true) { await ns.share(); } }\n', 
            "w"
        );
    }

    ns.print("[Auto-Share] Starting optimized share manager...");

    let previousThreads = 0;

    while (true) {
        // 1. Check true current free RAM on home
        const maxRam = ns.getServerMaxRam("home");
        const usedRam = ns.getServerUsedRam("home");
        const scriptRam = ns.getScriptRam(workerScript, "home"); // Costs 4 GB per thread
        
        // Let's look at purely baseline free RAM without the current worker chewing it up
        const baseUsedRam = usedRam - (previousThreads * scriptRam);
        const freeRam = (maxRam - baseUsedRam) - reservedRam;
        let targetThreads = Math.floor(freeRam / scriptRam);

        if (targetThreads > 0) {
            // 2. ONLY restart the worker if the thread count actually needs to change!
            if (targetThreads !== previousThreads) {
                ns.scriptKill(workerScript, "home");
                ns.exec(workerScript, "home", targetThreads);
                
                const currentPower = ns.getSharePower();
                const bonusPercent = ((currentPower - 1.0) * 100).toFixed(2);
                
                ns.print(`[Auto-Share] Resized threads: ${previousThreads} ➔ ${targetThreads} | Power: ${currentPower.toFixed(4)}x (+${bonusPercent}%)`);
                previousThreads = targetThreads;
            } else {
                // If thread count hasn't changed, DO NOT kill it. Let it run continuously.
                const currentPower = ns.getSharePower();
                const bonusPercent = ((currentPower - 1.0) * 100).toFixed(2);
                ns.print(`[Auto-Share] Maintaining ${targetThreads} threads | Power: ${currentPower.toFixed(4)}x (+${bonusPercent}%)`);
            }
        } else {
            if (previousThreads > 0) {
                ns.scriptKill(workerScript, "home");
                ns.print(`[Auto-Share] Threads: ${previousThreads} ➔ 0 | Paused (Not enough free RAM).`);
                previousThreads = 0;
            } else {
                ns.print(`[Auto-Share] Waiting for RAM...`);
            }
        }

        // Check RAM changes every 10 seconds without disrupting active share cycles
        await ns.sleep(10000);
    }
}