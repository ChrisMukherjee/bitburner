
/** @param {NS} ns */
export async function main(ns) {
    ns.disableLog("ALL");

    // Stop any older orchestrator, so running this again replaces it instead of doubling up
    for (const proc of ns.ps("home")) {
        if (proc.filename === ns.getScriptName() && proc.pid !== ns.pid) ns.kill(proc.pid);
    }

    // Singularity one-shots sit right after the batcher: they run for a few seconds only when affordable, and may pause lower daemons to get room.
    // Highest priority first (money per GB of home RAM). `ready` (optional) says when a daemon can start.
    // A daemon only starts if its real RAM fits; if a higher one is waiting, lower ones are stopped to make room.
    const singOn = () => String(ns.read("sing-info.txt")).startsWith("1");   // Singularity usable (BitNode 4 or SF4)
    const stamp = () => String(ns.read("reset-info.txt"));
    // offHome daemons run on another rooted server when one has room (their files are copied along; the Singularity
    // one-shots copy their results back to home). Where each one runs is remembered in offhome.txt.
    const lastRun = {};   // script -> time it last started (for daemons with `every`)
    let hostCache = otherHosts(ns);   // refreshed every pass
    const remoteHost = d => d.offHome ? hostCache.find(h => ns.isRunning(d.script, h, ...(d.args || []))) : undefined;
    const remoteUp = d => !!remoteHost(d);
    const daemons = [
        {
            script: "auto-destroy.js", quiet: true, every: 2 * 60 * 1000,   // destroyW0r1dD43m0n costs 32 GB, so this runs on home and pauses lower daemons for a moment (first in the list = can make room)
            // when node-ready.txt says 1 (Red Pill installed + hacking level reached, or all Black Ops done): moves to the best next BitNode. Off switch: run auto-destroy.js --off
            ready: () => singOn() && ns.read("node-ready.txt").trim() === "1" && !ns.fileExists("auto-destroy-off.txt", "home"),
        },
        { script: "/hack/batcher.js" },          // earns the most per GB; leaves homeReserveGb free on home. Backup: "/hack/controller-jit.js"
        {
            script: "upgrade-home-ram.js", offHome: true, files: ["sing-info.txt", "reset-info.txt", "programs-next.txt", "programs-done.txt", "home-ram-next.txt", "home-ram-maxed.txt", "backdoor-next.txt", "backdoor-done.txt"],       // home RAM upgrades unlock every other daemon
            ready: () => singOn() && ns.read("home-ram-maxed.txt") !== stamp() && ns.getServerMoneyAvailable("home") >= (Number(ns.read("home-ram-next.txt")) || 0),
            quiet: true,   // one-shot pass: runs only when the next upgrade is affordable, then exits
        },
        {
            script: "upgrade-home-cores.js",     // after 64 GB home RAM: more cores make home threads stronger
            offHome: true, quiet: true, every: 2 * 60 * 1000,
            files: ["sing-info.txt", "reset-info.txt", "home-cores-next.txt", "home-cores-maxed.txt"],
            ready: () => singOn() && ns.getServerMaxRam("home") >= 64 && ns.read("home-cores-maxed.txt") !== stamp() && ns.getServerMoneyAvailable("home") >= (Number(ns.read("home-cores-next.txt")) || 0),
        },
        {
            script: "buy-programs.js", offHome: true, homeOk: true, retrySoon: true, files: ["sing-info.txt", "reset-info.txt", "programs-next.txt", "programs-next-stamp.txt", "programs-done.txt", "home-ram-next.txt", "home-ram-maxed.txt", "backdoor-next.txt", "backdoor-done.txt"],           // TOR + port openers + DarkscapeNavigator + Formulas
            ready: () => singOn() && ns.read("programs-done.txt") !== stamp() && ns.getServerMoneyAvailable("home") >= (ns.read("programs-next-stamp.txt") === stamp() ? Number(ns.read("programs-next.txt")) || 0 : 0),
            quiet: true,   // one-shot pass: runs only when the next purchase is affordable, then exits
        },
        {
            script: "auto-backdoor.js", offHome: true, files: ["sing-info.txt", "reset-info.txt", "programs-next.txt", "programs-done.txt", "home-ram-next.txt", "home-ram-maxed.txt", "backdoor-next.txt", "backdoor-done.txt"],          // Singularity: does the backdoors itself
            ready: () => singOn() && ns.read("backdoor-done.txt") !== stamp() && Date.now() >= (Number(ns.read("backdoor-next.txt")) || 0),
            quiet: true,   // one pass every ~3 minutes, then exits
        },
        {
            script: "faction-goals.js",          // rep goal per faction -> port 23 (about 22 GB, for a moment, off home)
            offHome: true, quiet: true, every: 10 * 60 * 1000,
            files: ["utils/config.js", "utils/notify.js", "utils/aug-filter.js", "config.js", "data/config.json", "data/bitnode.txt", "rep-horizon.txt", "bb-state.txt"],
            ready: () => singOn(),
        },
        {
            script: "bb-manage.js",             // Bladeburner housekeeping from the live Source-Files: joins, skills, writes bb-state.txt (off / train / run)
            offHome: true, homeOk: true, retrySoon: true, quiet: true, every: 3 * 60 * 1000,
            files: ["sing-info.txt", "bb-state.txt"],
            ready: () => singOn(),
        },
        {
            script: "bb-pass.js",                // Bladeburner: best action for rank per second, one short pass (the game keeps repeating the action)
            offHome: true, homeOk: true, retrySoon: true, quiet: true, every: 30 * 1000,
            files: ["bb-state.txt", "bb-rank.json"],
            ready: () => ns.read("bb-state.txt") === "run",
        },
        {
            script: "faction-pass.js",           // joins invites and starts what the player should be doing (programs, study, faction rep, crime), then exits; it keeps running in the game
            offHome: true, homeOk: true, retrySoon: true, quiet: true, every: 60 * 1000,   // homeOk: early in a run, before other servers have room, it may use home for the second it takes
            files: ["utils/config.js", "utils/notify.js", "utils/aug-filter.js", "config.js", "data/config.json", "data/bitnode.txt", "sing-info.txt", "bb-state.txt"],
            ready: () => singOn(),
        },
        {
            script: "program-pass.js",           // starts creating a port opener when faction-pass.js asks (player-do.txt)
            offHome: true, homeOk: true, retrySoon: true, quiet: true, every: 30 * 1000,
            files: ["utils/config.js", "config.js", "data/config.json", "data/bitnode.txt", "sing-info.txt", "bb-state.txt"],
            ready: () => singOn() && ns.read("player-do.txt") === "programs",
        },
        {
            script: "crime-pass.js",             // commits a crime for gang karma when faction-pass.js asks (player-do.txt)
            offHome: true, homeOk: true, retrySoon: true, quiet: true, every: 30 * 1000,
            files: ["utils/config.js", "config.js", "data/config.json", "data/bitnode.txt", "sing-info.txt", "bb-state.txt"],
            ready: () => singOn() && ns.read("player-do.txt") === "crime",
        },
        {
            script: "company-pass.js",           // Tian Di Hui + megacorp jobs for faction invites when no faction needs rep; one short pass, then exits
            offHome: true, homeOk: true, retrySoon: true, quiet: true, every: 60 * 1000,
            files: ["utils/config.js", "utils/notify.js", "utils/aug-filter.js", "config.js", "data/config.json", "data/bitnode.txt", "sing-info.txt", "company-wanted.txt", "bb-state.txt"],
            ready: () => singOn(),
        },
        {
            script: "augs-plan.js", args: ["--plan"],   // what could be bought and whether to reset -> data/aug-plan.json (about 28 GB, off home, for a moment)
            offHome: true, quiet: true, every: 20 * 60 * 1000,
            files: ["utils/config.js", "utils/notify.js", "utils/aug-filter.js", "utils/income.js", "config.js", "data/config.json", "data/bitnode.txt", "data/aug-plan.json", "sing-info.txt", "reset-info.txt", "bb-state.txt"],
            ready: () => singOn() && !ns.fileExists("do-reset.txt", "home"),
        },
        {
            script: "buy-augs.js",                    // after reset-now.js: buy every useful augmentation you can afford
            offHome: true, quiet: true,
            files: ["utils/config.js", "utils/notify.js", "utils/aug-filter.js", "utils/income.js", "config.js", "data/config.json", "data/bitnode.txt", "data/aug-plan.json", "sing-info.txt", "reset-info.txt", "bb-state.txt"],
            ready: () => singOn() && ns.fileExists("do-reset.txt", "home") && (Number(ns.read("augs-bought.txt")) || 0) < Number(ns.read("do-reset.txt")),
        },
        {
            script: "install-run.js",                 // after the purchase: install and restart (RESETS the run)
            offHome: true, quiet: true,
            files: ["sing-info.txt", "orchestrator.js"],
            ready: () => singOn() && ns.fileExists("do-reset.txt", "home") && (Number(ns.read("augs-bought.txt")) || 0) >= Number(ns.read("do-reset.txt")),
        },
        {
            script: "node-eta.js",              // how far the BitNode is from ending (hacking level vs w0r1d_d43m0n, Red Pill) -> node-eta.txt, node-ready.txt
            offHome: true, quiet: true, every: 5 * 60 * 1000,
            files: ["sing-info.txt", "reset-info.txt", "node-eta-state.json", "utils/income.js", "bb-state.txt", "bb-status.txt", "bb-rank.json"],
            ready: () => singOn(),
        },
        {
            script: "income-log.js",             // notes the income every 5 min, for reset-compare.js
            offHome: true, quiet: true, every: 5 * 60 * 1000,
            files: ["income-log.txt", "reset-info.txt"],
            ready: () => true,
        },
        { script: "purchase-server-8gb.js" },    // more server RAM = more batcher income
        {
            script: "gang.js",
            ready: () => ns.fileExists("gang-ready.txt", "home") && ns.read("gang-ready.txt").trim() === "1",
            waitingFor: "a gang (create one from the Factions tab once your karma is low enough)",
        },
        { script: "hacknet.js", offHome: true, files: ["reset-info.txt", "money-peak.txt"] },
        { script: "backdoor-watch.js", ready: () => !singOn(), quiet: true, waitingFor: "no Singularity (it only reminds you; auto-backdoor.js replaces it with Singularity)" },
        {
            script: "contracts.js",              // one short pass every ~5 min, off home (needs ~27 GB on a server for a moment)
            offHome: true, quiet: true,
            files: ["lib-target.js", "lib-contracts.js", "scout_nodes.txt", "contracts-unsolved.txt"],
            ready: () => Date.now() >= (Number(ns.read("contracts-next.txt")) || 0),
        },
        // The repo's IPvGO bot (tree search, rotates opponents) replaces IPvGO-lite while go/ipvgo-bot.js is in your folder.
        // To go back to IPvGO-lite, delete or rename go/ipvgo-bot.js in the folder and in the game.
        { script: "go/ipvgo-bot.js", offHome: true, files: ["go/choose-move.js"], ready: () => ns.fileExists("go/ipvgo-bot.js", "home"), quiet: false, waitingFor: "go/ipvgo-bot.js" },
        { script: "IPvGO-lite.js", offHome: true, ready: () => !ns.fileExists("go/ipvgo-bot.js", "home"), waitingFor: "go/ipvgo-bot.js to be removed" },
        {
            script: "darkweb.js",
            ready: () => ns.hasTorRouter() && ns.fileExists("DarkscapeNavigator.exe", "home"),
            waitingFor: "a TOR router and DarkscapeNavigator.exe (buy both from the terminal)",
        },
    ];

    ns.tprint("==================================================");
    ns.tprint("         INITIALIZING AUTOMATION SUITE            ");
    ns.tprint("==================================================");

    // Fresh start: stop old copies so they pick up any code changes
    for (const d of daemons) {
        if (ns.isRunning(d.script, "home")) {
            ns.tprint(`[Boot] ${d.script} is already running. Stopping old instance...`);
            killScript(ns, d.script);
        }
        const there = remoteHost(d);
        if (there) {
            ns.tprint(`[Boot] ${d.script} is already running on ${there}. Stopping old instance...`);
            ns.kill(d.script, there, ...(d.args || []));
        }
    }

    // Trims passwords.json to the live darknet map every 30 minutes, once darkweb.js is running
    const PRUNE_EVERY = 30 * 60 * 1000;
    let lastPrune = Date.now();

    const waiting = new Set();
    const lowRam = new Set();
    let firstPass = true;
    let tick = 0;
    let lastHold = -1;
    let lastCompareFor = 0;
    let lastClean = 0;
    let lastReserve = "";
    let announcedReset = false;
    const tooBig = new Set();   // scripts already reported as bigger than every server
    const RESERVE_PORT = 40;   // the batcher peeks this port for {host: GB} to leave free on other servers
    let fast = false;   // a quiet one-shot just ran: come back sooner so paused daemons restart

    // Daemons read reset-info.txt, so write it before the first launch
    if (ns.getScriptRam("reset-marker.js", "home") <= ns.getServerMaxRam("home") - ns.getServerUsedRam("home")) { ns.exec("reset-marker.js", "home"); await ns.sleep(200); }

    // Stays running: starts daemons once they are ready, and restarts any that stop
    while (true) {
        // Ask the game whether we're in a gang before launching anything, while the check can still find room
        if (tick % 10 === 0) { runOnce(ns, "sing-info.js"); await ns.sleep(500); }
        if (!ns.isRunning("gang.js", "home")) {
            runOnce(ns, "gang-check.js");
            await ns.sleep(500);
        }

        hostCache = otherHosts(ns);
        const hosts = hostCache;
        const reserve = {};   // GB to keep free on other servers for offHome daemons that found no room (the batcher reads offhome-reserve.txt)
        let quietLaunched = false;   // start at most one Singularity one-shot per pass so they don't squeeze everything at once
        let hold = 0;   // GB to keep free for a higher-priority daemon that would fit but is waiting
        for (let i = 0; i < daemons.length; i++) {
            const d = daemons[i];
            if (ns.isRunning(d.script, "home", ...(d.args || [])) || remoteUp(d)) { if (d.quiet) quietLaunched = true; continue; }

            if (d.quiet && quietLaunched) continue;
            if (d.every && Date.now() - (lastRun[d.script + (d.args || []).join(" ")] || 0) < d.every) continue;
            if (d.before) d.before();
            if (d.ready && !d.ready()) {
                if (!waiting.has(d.script) && !d.quiet) {
                    ns.tprint(`[Boot] ${d.script} will start once you have ${d.waitingFor}.`);
                    waiting.add(d.script);
                }
                continue;
            }

            const need = ns.getScriptRam(d.script, "home");
            if (need <= 0) {
                ns.print(`[Boot] [ERROR] ${d.script} not found on home.`);
                continue;
            }
            // A script bigger than every other server can never run off home: let it use home (the stop-lower-daemons / hold-room logic below), and say so once.
            const canHold = hosts.some(h => ns.getServerMaxRam(h) >= need);
            if (d.offHome && (canHold || d.homeOk)) {
                const host = placeOffHome(ns, d, need, hosts, reserve);
                if (host) {
                    lastRun[d.script + (d.args || []).join(" ")] = Date.now();
                    if (d.quiet) { fast = true; quietLaunched = true; }
                    else ns.tprint(`[Boot] Launched ${d.script} on ${host}`);
                    waiting.delete(d.script);
                    lowRam.delete(d.script);
                    continue;
                }
                // No other server has room right now (the batcher has been asked to free some). Don't fall back to home:
                // that is where the batcher and server buying live, and a 9-13 GB daemon there starves them.
                // Exception: a short one-shot marked homeOk runs on home when it fits in the free RAM right now.
                if (d.homeOk && ns.getServerMaxRam("home") - ns.getServerUsedRam("home") >= need && ns.exec(d.script, "home", 1, ...(d.args || [])) > 0) {
                    lastRun[d.script + (d.args || []).join(" ")] = Date.now();
                    if (d.quiet) { fast = true; quietLaunched = true; }
                } else if (d.quiet && d.retrySoon) {
                    fast = true;   // no room right now: look again in 8 seconds (the batcher has just been asked to free some) instead of in a minute
                }
                continue;
            }
            if (d.offHome && !tooBig.has(d.script)) {
                tooBig.add(d.script);
                if (need > ns.getServerMaxRam("home")) ns.tprint(`[Boot] ${d.script} needs ${ns.format.ram(need)} but home only has ${ns.format.ram(ns.getServerMaxRam("home"))} and no other server is big enough. It cannot run until you have more RAM.`);
                else if (!d.quiet) ns.tprint(`[Boot] ${d.script} needs ${ns.format.ram(need)}: no other server is big enough, so it runs on home.`);
            }
            let free = ns.getServerMaxRam("home") - ns.getServerUsedRam("home");
            // Not enough room: stop lower-priority daemons (lowest first), but only if that really makes it fit
            if (free < need) {
                const victims = [];
                let gain = 0;
                for (let j = daemons.length - 1; j > i && free + gain < need; j--) {
                    const r = ns.getRunningScript(daemons[j].script, "home");
                    if (!r) continue;
                    victims.push(daemons[j].script);
                    gain += ns.getScriptRam(daemons[j].script, "home") * r.threads;
                }
                if (free + gain >= need) {
                    for (const v of victims) killScript(ns, v);
                    if (!d.quiet) ns.tprint(`[Boot] Stopped ${victims.join(", ")} to make room for ${d.script}.`);
                    free += gain;
                }
            }
            if (free < need) {
                // Could it fit if everything of lower priority stopped? Then hold the room: no lower daemon may start.
                // If not (too big next to the higher-priority ones), skip it so it doesn't block the rest.
                // Batcher worker threads on home don't count against it: the hold below makes the batcher free that room.
                // Only this orchestrator and the higher-priority daemons are counted as fixed.
                let used = ns.getScriptRam(ns.getScriptName(), "home"), higher = 0;
                for (let j = 0; j < i; j++) {
                    const r = ns.getRunningScript(daemons[j].script, "home");
                    if (r && !daemons[j].quiet) higher += ns.getScriptRam(daemons[j].script, "home") * r.threads;   // one-shots are brief: they don't count
                }
                const fits = ns.getServerMaxRam("home") - used - higher >= need;
                if (!lowRam.has(d.script) && !d.quiet) {
                    ns.tprint(`[Boot] ${d.script} needs ${ns.format.ram(need)} but only ${ns.format.ram(free)} is free. ${fits ? "Holding the room: lower-priority daemons wait." : "Too big next to higher-priority daemons, skipping until RAM grows."}`);
                    lowRam.add(d.script);
                }
                if (fits) { hold = Math.ceil(need + 1); break; }
                continue;
            }

            const pid = ns.exec(d.script, "home", 1, ...(d.args || []));
            if (pid > 0) {
                lastRun[d.script + (d.args || []).join(" ")] = Date.now();
                if (d.quiet) { fast = true; quietLaunched = true; }
                if (!d.quiet) ns.tprint(`[Boot] ${firstPass || waiting.has(d.script) || lowRam.has(d.script) ? "Launched" : "Restarted"} ${d.script} (PID: ${pid})`);
                waiting.delete(d.script);
                lowRam.delete(d.script);
            } else {
                ns.print(`[Boot] [ERROR] Couldn't launch ${d.script}. Retrying in 1 minute.`);
            }
        }

        const reserveText = JSON.stringify(reserve);
        if (reserveText !== lastReserve) { lastReserve = reserveText; ns.clearPort(RESERVE_PORT); ns.writePort(RESERVE_PORT, reserveText); }

        // The planner's advice (data/aug-plan.json, copied back to home): tell the player once when it turns to RESET
        try {
            const plan = JSON.parse(ns.read("data/aug-plan.json"));
            // Only a plan made this run (after the last install) and in the last 40 minutes counts; an old file from earlier is ignored
            const fresh = plan?.checkedAt >= (Number(ns.read("reset-info.txt")) || 0) && Date.now() - plan.checkedAt < 40 * 60 * 1000;
            const wantReset = fresh && !!plan?.decision?.reset && !ns.fileExists("do-reset.txt", "home");
            if (wantReset && ns.peek(41) !== 1) {
                ns.clearPort(41); ns.writePort(41, 1);   // remembered across orchestrator restarts, so you hear it once per episode
                ns.tprint(`[Reset] Advice is RESET: ${plan.decision.reason}. Would buy: ${[...(plan.affordable || [])].join(", ") || "nothing new"} (already bought: ${[...(plan.queued || [])].join(", ") || "none"}), about $${ns.format.number(plan.cost || 0)}. Run reset-now.js to buy and install them.`);
                ns.toast("Reset advice is RESET. Run reset-now.js", "warning", 30000);
            }
            // Second opinion (reset-compare.js, quiet) refreshed right after each new plan; automatic resets need BOTH rules to say RESET
            if (fresh && plan.checkedAt > lastCompareFor && !ns.isRunning("reset-compare.js", "home")) {
                lastCompareFor = plan.checkedAt;
                ns.rm("reset-verdict.txt", "home");
                if (ns.getScriptRam("reset-compare.js", "home") <= ns.getServerMaxRam("home") - ns.getServerUsedRam("home")) ns.exec("reset-compare.js", "home", 1, "--quiet");
            }
            // While Bladeburner is the route, the planner values combat/Bladeburner augments and not hacking ones (utils/config.js routeAdjust),
            // so a RESET verdict then means combat augs: with them the combat stats come back in minutes. No separate hold is needed.
            if (wantReset && !ns.fileExists("auto-reset-off.txt", "home")) {   // automatic resets are ON unless you ran: run reset-now.js --auto off
                let mine = null;
                try { mine = JSON.parse(ns.read("reset-verdict.txt")); } catch { }
                if (mine && mine.reset && Date.now() - mine.t < 40 * 60 * 1000) {
                    ns.tprint("[Reset] Automatic resets are ON and both rules say RESET: requesting the purchase and install now (turn off with: run reset-now.js --auto off).");
                    runOnce(ns, "reset-now.js");
                }
            }
            if (fresh && !plan?.decision?.reset) ns.clearPort(41);   // advice went back to WAIT: announce again next time
            announcedReset = wantReset;
        } catch { }

        // Tell the batcher how much home RAM to leave free (it reads ram-hold.txt), so a waiting daemon can get its room
        if (hold !== lastHold) {
            lastHold = hold;
            ns.exec("ram-hold.js", "home", 1, hold);
        }

        if (Date.now() - lastPrune >= PRUNE_EVERY && ns.isRunning("darkweb.js", "home")) {
            if (!ns.isRunning("prune-vault.js", "home")) ns.exec("prune-vault.js", "home", 1, "--auto");
            lastPrune = Date.now();
        }

        // Small jobs live in their own scripts so the orchestrator stays small: they run, finish and free their RAM
        runOnce(ns, "reset-marker.js");
        if (!singOn()) runOnce(ns, "shop-reminder.js");   // silent with Singularity, so not worth a process every minute
        if (ns.fileExists("share-on.txt", "home") || ns.isRunning("share-worker.js", "home")) runOnce(ns, "share-manager.js");
        if (++tick % 10 === 0 && Date.now() - lastClean > 60000) { lastClean = Date.now(); runOnce(ns, "clean-intel.js"); }

        if (firstPass) {
            ns.tprint("All available systems running. Orchestrator stays on to start the rest when ready.");
            ns.tprint("==================================================");
            firstPass = false;
        }
        await ns.sleep(fast ? 8000 : 60000);
        fast = false;
    }
}

/** Stops every copy of a script on home. Uses ps + kill, which cost 0.7 GB together; scriptKill alone costs 1 GB. */
function killScript(ns, name) {
    for (const p of ns.ps("home")) if (p.filename === name) ns.kill(p.pid);
}

/** Starts a one-shot helper script if it isn't already running and fits in the free RAM. */
function runOnce(ns, script) {
    if (ns.isRunning(script, "home")) return;
    const free = ns.getServerMaxRam("home") - ns.getServerUsedRam("home");
    if (ns.getScriptRam(script, "home") <= free) ns.exec(script, "home");
}

/** Every rooted server except home, by walking the network from home. */
function otherHosts(ns) {
    const seen = new Set(["home"]), queue = ["home"], out = [];
    while (queue.length) {
        for (const next of ns.scan(queue.shift())) {
            if (seen.has(next)) continue;
            seen.add(next);
            queue.push(next);
            if (ns.hasRootAccess(next) && ns.getServerMaxRam(next) > 0) out.push(next);
        }
    }
    return out;
}

/**
 * Copies an offHome daemon to another server with room (the one with the least free RAM that still fits) and starts it.
 * Returns the host, or null. If none has room now, it asks the batcher (through `reserve`) to leave room on the
 * smallest server that could hold it, and the next pass will find it free.
 */
function placeOffHome(ns, d, need, hosts, reserve) {
    const files = [d.script, ...(d.files || [])].filter(f => ns.fileExists(f, "home"));
    const fit = hosts
        .map(h => ({ h, free: ns.getServerMaxRam(h) - ns.getServerUsedRam(h) }))
        .filter(x => x.free >= need)
        .sort((a, b) => a.free - b.free);
    for (const { h } of fit) {
        if (!ns.scp(files, h, "home")) continue;
        if (ns.exec(d.script, h, 1, ...(d.args || [])) > 0) return h;
    }
    const roomy = hosts
        .filter(h => ns.getServerMaxRam(h) - (reserve[h] || 0) >= need)
        .sort((a, b) => ns.getServerMaxRam(a) - ns.getServerMaxRam(b))[0];
    if (roomy) reserve[roomy] = (reserve[roomy] || 0) + need;
    return null;
}
