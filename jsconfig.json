{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": false,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "/*": ["./*"]
    }
  },
  "include": ["**/*.js", "**/*.d.ts"],
  "exclude": ["node_modules", "archive", "data"]
}
